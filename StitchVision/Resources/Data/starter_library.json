    {
        "id": "starter_009", "title": "Vanilla Socks", "difficulty": "Intermediate",
        "category": "Socks", "craft_type": "knitting", "estimated_hours": 12,
        "yarn_weight": "fingering", "needle_size": "US 1", "hook_size": null,
        "gauge": "32 sts x 44 rows = 4in", "source_credit": "Public Domain (pre-1927)",
        "tags": ["socks", "intermediate", "circular"], "is_featured": false, "supports_rounds": true,
        "steps": [
            {"row": 1, "text": "Cast on 64 stitches. Join in round.", "type": "setup", "is_round": true},
            {"row": 2, "text": "K2, P2 ribbing for 16 rounds.", "type": "main", "is_round": true},
            {"row": 3, "text": "Knit every round for 48 rounds (stockinette leg).", "type": "main", "is_round": true},
            {"row": 4, "text": "Heel flap: Knit 32 sts. Turn. Sl 1, purl back.", "type": "main", "is_round": false},
            {"row": 5, "text": "Repeat sl 1, k1 on RS; sl 1, purl back on WS for 32 rows.", "type": "main", "is_round": false},
            {"row": 6, "text": "Heel turn: Sl 1, k17, ssk, k1, turn. Sl 1, p5, p2tog, p1, turn.", "type": "main", "is_round": false},
            {"row": 7, "text": "Continue heel turn until all sts worked. (18 sts)", "type": "main", "is_round": false},
            {"row": 8, "text": "Pick up 16 sts along each side of heel flap. Knit across instep. Join round.", "type": "main", "is_round": true},
            {"row": 9, "text": "Gusset: K to 3 sts before instep, k2tog, k1. K instep. K1, ssk, k to end.", "type": "main", "is_round": true},
            {"row": 10, "text": "Repeat gusset decreases every other round until 64 sts remain.", "type": "main", "is_round": true},
            {"row": 11, "text": "Knit even until foot measures 7.5 inches from heel.", "type": "main", "is_round": true},
            {"row": 12, "text": "Toe: K to 3 sts before end of needle, k2tog, k1. Repeat on each needle.", "type": "main", "is_round": true},
            {"row": 13, "text": "Repeat toe decreases every round until 16 sts remain. Graft with Kitchener stitch.", "type": "finish", "is_round": true}
        ]
    },
