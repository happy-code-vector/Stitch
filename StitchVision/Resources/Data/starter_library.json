    {
        "id": "starter_006", "title": "Easy Crochet Granny Square", "difficulty": "Beginner",
        "category": "Dishcloths & Squares", "craft_type": "crochet", "estimated_hours": 1,
        "yarn_weight": "worsted", "needle_size": null, "hook_size": "5.0mm",
        "gauge": null, "source_credit": "Public Domain (pre-1927)",
        "tags": ["granny", "square", "beginner"], "is_featured": false, "supports_rounds": true,
        "steps": [
            {"row": 1, "text": "Ch 4, sl st to form ring.", "type": "setup", "is_round": true},
            {"row": 2, "text": "Ch 3, 2 dc in ring, ch 2, [3 dc, ch 2] 3 times, sl st to top of ch-3.", "type": "main", "is_round": true},
            {"row": 3, "text": "Sl st to ch-2 sp, ch 3, 2 dc, ch 2, 3 dc in same sp. Ch 1, [3 dc, ch 2, 3 dc] in next ch-2 sp. Repeat around.", "type": "main", "is_round": true},
            {"row": 4, "text": "Continue pattern, working 3 dc groups in each ch-1 sp and corners in ch-2 sps.", "type": "main", "is_round": true},
            {"row": 5, "text": "Continue until square is desired size. Sl st to finish.", "type": "finish", "is_round": true}
        ]
    },
    {
        "id": "starter_007", "title": "Basic Crochet Scarf", "difficulty": "Beginner",
        "category": "Scarves & Cowls", "craft_type": "crochet", "estimated_hours": 5,
        "yarn_weight": "worsted", "needle_size": null, "hook_size": "5.5mm",
