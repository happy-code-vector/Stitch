        "steps": [
            {"row": 1, "text": "Cast on 28 stitches. Join in round.", "type": "setup", "is_round": true},
            {"row": 2, "text": "K1, P1 ribbing for 12 rounds.", "type": "main", "is_round": true},
            {"row": 3, "text": "Knit every round for 14 rounds (stockinette).", "type": "main", "is_round": true},
            {"row": 4, "text": "K14, place marker, k14.", "type": "main", "is_round": true},
