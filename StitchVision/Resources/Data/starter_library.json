        "tags": ["scarf", "beginner", "gift"], "is_featured": false, "supports_rounds": false,
        "steps": [
            {"row": 1, "text": "Ch 21.", "type": "setup", "is_round": false},
            {"row": 2, "text": "Sc in 2nd ch from hook, sc across. (20 sc)", "type": "main", "is_round": false},
            {"row": 3, "text": "Ch 1, turn. Sc in each sc across.", "type": "main", "is_round": false},
            {"row": 4, "text": "Repeat row 3 until scarf measures 60 inches.", "type": "main", "is_round": false},
            {"row": 5, "text": "Fasten off and weave in ends.", "type": "finish", "is_round": false}
        ]
    },
    {
        "id": "starter_008", "title": "Crochet Beanie", "difficulty": "Easy",
