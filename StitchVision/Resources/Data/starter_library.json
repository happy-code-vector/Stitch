            {"row": 3, "text": "Ch 2, [2 dc in next dc, dc in next dc] around. (30 dc)", "type": "main", "is_round": true},
            {"row": 4, "text": "Ch 2, [2 dc in next dc, dc in next 2 dc] around. (40 dc)", "type": "main", "is_round": true},
            {"row": 5, "text": "Ch 2, dc in each dc around. (40 dc)", "type": "main", "is_round": true},
            {"row": 6, "text": "Repeat round 5 until hat measures 7 inches from crown.", "type": "main", "is_round": true},
            {"row": 7, "text": "Ch 1, sc in each dc around. Repeat for 2 rounds (brim).", "type": "main", "is_round": true},
            {"row": 8, "text": "Fasten off and weave in ends.", "type": "finish", "is_round": true}
        ]
